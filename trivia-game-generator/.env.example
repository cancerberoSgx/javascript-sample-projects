# Copy to .env and adjust: cp .env.example .env
# docker/docker-compose.yml reads this file (docker/.env is a symlink to it).

# --- Postgres (used by the db container) ---
POSTGRES_USER=trivia
POSTGRES_PASSWORD=trivia
POSTGRES_DB=trivia
# Host port mapped to the db container's 5432
POSTGRES_HOST_PORT=5433

# --- Database URLs ---
# Used when running the backend directly on your machine (uv run ...).
# Inside docker-compose the backend gets DATABASE_URL pointing at the "db" service instead.
DATABASE_URL=postgresql://trivia:trivia@localhost:5433/trivia
# Separate database for the backend test suite (created by docker/postgres-init/)
TEST_DATABASE_URL=postgresql://trivia:trivia@localhost:5433/trivia_test

# --- Backend ---
BACKEND_HOST_PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=480
# Lifetime of the token a root user gets when impersonating a member
IMPERSONATION_EXPIRE_MINUTES=60
# Encrypts organization OpenAI / Gemini keys. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes already-stored keys unreadable.
ENCRYPTION_KEY=change-me
# First root user, created on startup only if no root user exists yet
ROOT_EMAIL=root@example.com
ROOT_PASSWORD=change-me-please
ROOT_NAME=Root
ROOT_ORGANIZATION=Default
AUTO_MIGRATE=true
RUN_SEEDS=true

# --- Card generation (rules.md §2.2.1) ---
# The API keys are stored per organization (Organizations tab), never here. These are the default models
# for organizations that didn't choose their own.
OPENAI_MODEL=gpt-5.4-mini
GEMINI_MODEL=gemini-3.5-flash
# Cards per LLM call, and calls in flight per generation
GENERATION_BATCH_SIZE=20
GENERATION_PARALLEL_CALLS=3
# Only for the opt-in live tests (RUN_LIVE_LLM=1 uv run pytest tests/test_generation_live.py). The app ignores them.
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Background images (rules.md §2.1.2) ---
# Files are stored here and served at /media (the compose file mounts the "media" volume at /app/media).
# Default: backend/media. In production, serve this folder at /media from the web server or a CDN.
# MEDIA_DIR=
IMAGE_MAX_UPLOAD_MB=10
IMAGE_MAX_MEGAPIXELS=40
IMAGE_MAX_SIDE=3000
IMAGE_IMPORT_TIMEOUT_SECONDS=15

# --- Frontend ---
FRONTEND_HOST_PORT=5173
