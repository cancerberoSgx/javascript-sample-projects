# Copy to .env and adjust: cp .env.example .env
# docker/docker-compose.yml reads this file (docker/.env is a symlink to it).

# --- Postgres (used by the db container) ---
POSTGRES_USER=trivia
POSTGRES_PASSWORD=trivia
POSTGRES_DB=trivia
# Host port mapped to the db container's 5432
POSTGRES_HOST_PORT=5433

# --- Database URLs ---
# Used when running the backend directly on your machine (uv run ...).
# Inside docker-compose the backend gets DATABASE_URL pointing at the "db" service instead.
DATABASE_URL=postgresql://trivia:trivia@localhost:5433/trivia
# Separate database for the backend test suite (created by docker/postgres-init/)
TEST_DATABASE_URL=postgresql://trivia:trivia@localhost:5433/trivia_test

# --- Backend ---
BACKEND_HOST_PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=480
# Lifetime of the token a root user gets when impersonating a member
IMPERSONATION_EXPIRE_MINUTES=60
# Encrypts organization OpenAI keys. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes already-stored keys unreadable.
ENCRYPTION_KEY=change-me
# First root user, created on startup only if no root user exists yet
ROOT_EMAIL=root@example.com
ROOT_PASSWORD=change-me-please
ROOT_NAME=Root
ROOT_ORGANIZATION=Default
AUTO_MIGRATE=true
RUN_SEEDS=true

# --- Frontend ---
FRONTEND_HOST_PORT=5173
